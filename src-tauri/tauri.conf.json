{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex Pet",
  "version": "0.3.0",
  "identifier": "com.codex.pet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Pet",
        "width": 200,
        "height": 268,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "config",
        "title": "Codex Pet 设置",
        "url": "/config.html",
        "width": 440,
        "height": 820,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../adapters": "adapters"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQTEyQzY1OTU2REQ0NgpSV1JHM1ZaWnhoSzZESmdlQldUaVZ6Wjkrd1Y4SkpXaUFKVTEwbi9kalU1dUIrZkZoVEFCTDB6dAo=",
      "endpoints": [
        "https://github.com/shuxiayouzhimao/codex-DP/releases/latest/download/latest.json"
      ]
    }
  }
}
