{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default permissions + window controls for the pet",
  "windows": ["main", "config"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide"
  ]
}
